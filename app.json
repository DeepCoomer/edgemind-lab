{
  "expo": {
    "name": "EdgeMind Lab",
    "slug": "edgemind-lab",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "edgemindlab",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deepcoomer.edgemindlab"
    },
    "android": {
      "package": "com.deepcoomer.edgemindlab",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-build-properties",
      [
        "llama.rn",
        {
          "enableEntitlements": true
        }
      ],
      "expo-router",
      "./plugins/withProcessTextIntent.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "EdgeMind Lab needs access to your photos to scan text from an image.",
          "cameraPermission": "EdgeMind Lab needs camera access to scan text from a photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
